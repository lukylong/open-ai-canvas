{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {"title": "MiniMax H3 FL2VA INT8 模型"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": {"title": "Qwen3-VL MiniMax H3 INT8 文本编码器"}
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"},
    "_meta": {"title": "MiniMax H3 视频 VAE"}
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"},
    "_meta": {"title": "MiniMax H3 音频 VAE"}
  },
  "5": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["4", 0],
      "prompt": "",
      "width": 1344,
      "height": 768,
      "length": ["7", 1],
      "ref_image_size": "match"
    },
    "_meta": {"title": "MiniMax H3 全能多参考图生视频"}
  },
  "6": {
    "class_type": "PrimitiveFloat",
    "inputs": {"value": 5.0},
    "_meta": {"title": "时长（秒）"}
  },
  "7": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17",
      "values.a": ["6", 0]
    },
    "_meta": {"title": "H3 帧数对齐（24fps，17k+5）"}
  },
  "8": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": 1},
    "_meta": {"title": "随机种子"}
  },
  "9": {
    "class_type": "MiniMaxH3MemoryEfficientSageAttentionPatch",
    "inputs": {"model": ["1", 0]},
    "_meta": {"title": "MiniMax H3 SageAttention 显存优化"}
  },
  "10": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["9", 0],
      "lora_name": "minimax_h3_turbo_4步加速_comfyui.safetensors",
      "strength_model": 1.0
    },
    "_meta": {"title": "MiniMax H3 4步加速 LoRA"}
  },
  "11": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["10", 0],
      "scheduler": "beta",
      "steps": 8,
      "denoise": 1.0
    },
    "_meta": {"title": "MiniMax H3 Turbo 调度器"}
  },
  "12": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "euler"},
    "_meta": {"title": "MiniMax H3 Turbo 采样器"}
  },
  "13": {
    "class_type": "BasicGuider",
    "inputs": {"model": ["10", 0], "conditioning": ["5", 0]},
    "_meta": {"title": "MiniMax H3 引导"}
  },
  "14": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["13", 0],
      "sampler": ["12", 0],
      "sigmas": ["11", 0],
      "latent_image": ["5", 1]
    },
    "_meta": {"title": "MiniMax H3 Turbo 高级采样"}
  },
  "15": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["14", 0], "vae": ["3", 0]},
    "_meta": {"title": "解码视频"}
  },
  "16": {
    "class_type": "VAEDecodeAudio",
    "inputs": {"samples": ["14", 0], "vae": ["4", 0]},
    "_meta": {"title": "解码原生音频"}
  },
  "17": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["15", 0], "audio": ["16", 0], "fps": 24, "bit_depth": 8},
    "_meta": {"title": "合成 H3 音视频"}
  },
  "18": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["17", 0],
      "filename_prefix": "video/MiniMax_H3_AllReference_4step",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {"title": "保存 MiniMax H3 全能参考视频"}
  }
}
