{
  "1": {
    "class_type": "LoadImage",
    "inputs": {"image": "reference.png"},
    "_meta": {"title": "MiniMax H3 起始图"}
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {"title": "MiniMax H3 FL2VA 模型"}
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": {"title": "Qwen3-VL MiniMax H3 文本编码器"}
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"},
    "_meta": {"title": "MiniMax H3 视频 VAE"}
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"},
    "_meta": {"title": "MiniMax H3 音频 VAE"}
  },
  "6": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "first_frame": ["1", 0],
      "prompt": "",
      "width": 768,
      "height": 1344,
      "length": ["8", 1]
    },
    "_meta": {"title": "MiniMax H3 图生视频"}
  },
  "7": {
    "class_type": "PrimitiveFloat",
    "inputs": {"value": 5.0},
    "_meta": {"title": "时长（秒）"}
  },
  "8": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17",
      "values.a": ["7", 0]
    },
    "_meta": {"title": "H3 帧数对齐（24fps，17k+5）"}
  },
  "9": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": 1},
    "_meta": {"title": "随机种子"}
  },
  "10": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["2", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    },
    "_meta": {"title": "H3 调度器"}
  },
  "11": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "res_multistep"},
    "_meta": {"title": "H3 采样器"}
  },
  "12": {
    "class_type": "BasicGuider",
    "inputs": {"model": ["2", 0], "conditioning": ["6", 0]},
    "_meta": {"title": "H3 引导"}
  },
  "13": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["9", 0],
      "guider": ["12", 0],
      "sampler": ["11", 0],
      "sigmas": ["10", 0],
      "latent_image": ["6", 1]
    },
    "_meta": {"title": "H3 高级采样"}
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["13", 0], "vae": ["4", 0]},
    "_meta": {"title": "解码视频"}
  },
  "15": {
    "class_type": "VAEDecodeAudio",
    "inputs": {"samples": ["13", 0], "vae": ["5", 0]},
    "_meta": {"title": "解码原生音频"}
  },
  "16": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["14", 0], "audio": ["15", 0], "fps": 24, "bit_depth": 8},
    "_meta": {"title": "合成 H3 音视频"}
  },
  "18": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["16", 0],
      "filename_prefix": "video/MiniMax_H3",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {"title": "保存 MiniMax H3 视频"}
  }
}
